# Copy to .env and edit.
ENV=dev                            # Use production outside local development
LLM_BACKEND=extractive            # extractive | groq | anthropic | openai | hf | hf-lora
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=qwen2.5:1.5b
BASE_MODEL=Qwen/Qwen2.5-1.5B-Instruct
EMBED_MODEL=BAAI/bge-small-en-v1.5
JWT_SECRET=change-me               # Replace with a random 32+ character secret before deployment
MIN_DENSE=0.62
CORS_ORIGINS=http://localhost:8000

# Groq (OpenAI-compatible): set LLM_BACKEND=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
